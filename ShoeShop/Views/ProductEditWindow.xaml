<Window x:Class="ShoeShop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ID:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtId" IsReadOnly="True" Margin="0,3"/>

        <TextBlock Grid.Row="1" Text="Артикул:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtArticle" Margin="0,3"/>

        <TextBlock Grid.Row="2" Text="Наименование:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtName" Margin="0,3"/>

        <TextBlock Grid.Row="3" Text="Категория:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CmbCategory"
                   DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,3"/>

        <TextBlock Grid.Row="4" Text="Производитель:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="CmbManufacturer"
                   DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,3"/>

        <TextBlock Grid.Row="5" Text="Поставщик:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="CmbSupplier"
                   DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,3"/>

        <TextBlock Grid.Row="6" Text="Ед. измерения:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="CmbUnit"
                   DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,3"/>

        <TextBlock Grid.Row="7" Text="Цена:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TxtPrice" Margin="0,3"/>

        <TextBlock Grid.Row="8" Text="Скидка (%):" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TxtDiscount" Margin="0,3"/>

        <TextBlock Grid.Row="9" Text="Кол-во на складе:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="TxtStock" Margin="0,3"/>

        <TextBlock Grid.Row="10" Text="Описание:" VerticalAlignment="Top"/>
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtDesc"
                   Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3"/>

        <TextBlock Grid.Row="11" Text="Фото (300x200):" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="11" Grid.Column="1">
            <Image x:Name="ImgPreview" Height="120" Stretch="Uniform"
                   Source="/Resources/images.png"/>
            <Button Content="Загрузить фото" Width="160" Margin="0,5,0,0"
                    Click="BtnLoadImage_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Height="30" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="30" Margin="10,0,0,0"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>