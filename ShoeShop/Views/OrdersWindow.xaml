<Window x:Class="ShoeShop.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="BtnAddOrder" Content="Добавить заказ" Width="140"
                    Click="BtnAddOrder_Click"/>
            <Button x:Name="BtnDelOrder" Content="Удалить заказ" Width="140"
                    Margin="10,0,0,0" Click="BtnDelOrder_Click"/>
        </StackPanel>

        <ListBox x:Name="LstOrders" Grid.Row="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="LstOrders_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold"
                                           Text="{Binding Article, StringFormat='Артикул заказа: {0}'}"/>
                                <TextBlock Text="{Binding StatusName, StringFormat='Статус заказа: {0}'}"/>
                                <TextBlock Text="{Binding PickupPoint, StringFormat='Адрес пункта выдачи: {0}'}"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                           Text="{Binding DeliveryDate, StringFormat='Дата доставки: {0:dd.MM.yyyy}'}"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>