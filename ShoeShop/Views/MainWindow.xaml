<Window x:Class="ShoeShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продажа обуви" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ProductRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BigDiscount}" Value="True">
                    <Setter Property="Background" Value="#2E8B57"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF2ADC7E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="69*"/>
                <ColumnDefinition Width="496*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtUserInfo" HorizontalAlignment="Left"
                       FontWeight="Bold" VerticalAlignment="Center" Grid.Column="1" Margin="992,0,0,0"/>
            <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                <Button x:Name="BtnOrders" Content="Заказы" Width="100"
                        Visibility="Collapsed" Click="BtnOrders_Click"/>
                <Button x:Name="BtnAddProduct" Content="Добавить товар"
                        Width="130" Margin="10,0,0,0"
                        Visibility="Collapsed" Click="BtnAddProduct_Click"/>
                <Button Content="Выйти" Width="80" Margin="10,0,0,0"
                        Click="BtnLogout_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="PanelFilters" Grid.Row="1" Orientation="Horizontal"
                    Margin="0,10" Visibility="Collapsed">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSearch" Width="250" Margin="5,0,10,0"
                     TextChanged="Filter_Changed"/>

            <TextBlock Text="Сортировка по складу:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbSort" Width="140" Margin="5,0,10,0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <TextBlock Text="Поставщик:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbSupplier" Width="200" Margin="5,0,0,0"
                      DisplayMemberPath="Name"
                      SelectionChanged="Filter_Changed"/>
        </StackPanel>

        <ListBox x:Name="LstProducts" Grid.Row="2"
         ItemContainerStyle="{StaticResource ProductRowStyle}"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         MouseDoubleClick="LstProducts_MouseDoubleClick" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1"
                                Width="160" Height="110">
                            <Image Stretch="Uniform"
                                   Source="{Binding ImagePath, TargetNullValue=/Resources/images.png,
                                            FallbackValue=/Resources/images.png}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="15,0">
                            <TextBlock FontWeight="Bold" FontSize="14">
                                <Run Text="{Binding CategoryName}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding Name}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Description, StringFormat='Описание: {0}'}"/>
                            <TextBlock Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}"/>
                            <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}"/>
                            <TextBlock Text="{Binding UnitName, StringFormat='Единица измерения: {0}'}"/>
                            <TextBlock Text="{Binding StockQty, StringFormat='Количество на складе: {0}'}"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="  "/>
                                <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="Действующая скидка"/>
                                <LineBreak/>
                                <Run Text="{Binding Discount, StringFormat={}{0}%}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="BtnDelete" Grid.Row="3" Content="Удалить товар"
                Width="140" HorizontalAlignment="Left" Margin="0,10,0,0"
                Visibility="Collapsed" Click="BtnDelete_Click"/>
    </Grid>
</Window>