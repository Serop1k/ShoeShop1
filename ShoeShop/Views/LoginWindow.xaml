<Window x:Class="ShoeShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="300" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF324FEF" Offset="0.669"/>
            <GradientStop Color="Black" Offset="1"/>
            <GradientStop Color="White" Offset="0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="123*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Продажа обуви" FontSize="20"
                   FontWeight="Bold" HorizontalAlignment="Left" Margin="100,0,0,15" Grid.Column="1"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5" Grid.ColumnSpan="2">
            <TextBlock Text="Логин:" Width="80"/>
            <TextBox x:Name="TxtLogin" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,5" Grid.ColumnSpan="2">
            <TextBlock Text="Пароль:" Width="80"/>
            <PasswordBox x:Name="TxtPassword" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="44,15,0,15" Grid.Column="1">
            <Button Content="Войти" Width="110" Height="30" Click="BtnLogin_Click" Background="White"/>
            <Button Content="Войти как гость" Width="150" Height="30"
                    Margin="10,0,0,0" Click="BtnGuest_Click" Background="White"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TxtError" Foreground="Red"
                   HorizontalAlignment="Left" Grid.Column="1" Margin="178,0,0,0"/>
    </Grid>
</Window>